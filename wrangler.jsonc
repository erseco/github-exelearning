{
    "name": "github-exelearning",
    "main": "worker/index.ts",
    "compatibility_date": "2026-10-01",
    "observability": { "enabled": true },
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        // The editor (thousands of static files) never wakes the Worker.
        "run_worker_first": ["/*", "!/editor/*"]
    },
    "vars": {
        "APP_ORIGIN": "https://github.exelearning.dev",
        "EDITOR_ORIGIN": "https://github-editor.exelearning.dev",
        // Public values of the GitHub App; the client secret is a Worker secret:
        //   npx wrangler secret put GITHUB_CLIENT_SECRET
        "GITHUB_CLIENT_ID": "Iv23lihlcOQzs8HfWKbQ",
        "GITHUB_APP_SLUG": "exelearning"
    },
    "routes": [
        { "pattern": "github.exelearning.dev", "custom_domain": true },
        { "pattern": "github-editor.exelearning.dev", "custom_domain": true }
    ]
}
